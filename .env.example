HOST=127.0.0.1
PORT=3080
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3080
DATA_DIR=./data
# Production: set NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://social.storageaz.com
# Create the first owner on startup; remove password from environment after successful bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional publishing service. AI generation is disabled and no OpenAI key is used.
UPLOAD_POST_API_KEY=
MAX_UPLOAD_MB=250
